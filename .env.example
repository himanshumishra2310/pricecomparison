# Copy to .env (never commit it) or add these as GitHub Actions secrets.

# Which data source to use: browser (free Chromium crawl), serpapi (paid API, most reliable), fixture (test data)
PROVIDER=browser

# SerpApi (only if PROVIDER=serpapi)
SERPAPI_KEY=

# Email alerts (SMTP). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS=an App Password
ALERT_EMAIL_TO=revenue@saltstayz.com,himanshu.mishra@saltstayz.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp alerts, option A: Meta WhatsApp Cloud API (needs an approved template with one {{1}} body parameter)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# WhatsApp alerts, option B: Twilio (set these instead of the Meta ones)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Recipients for either option, comma separated, country code without +
WHATSAPP_TO=919876543210

# Browser crawl tuning (optional)
# BROWSER_CHANNEL=chrome
# BROWSER_PROFILE_DIR=.profile
# HEADLESS=false
# DEBUG_DIR=debug
